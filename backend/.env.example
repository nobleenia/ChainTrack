# ============================================
# ChainTrack Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to git!
#
# Generate secure keys with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================

# ===================
# Flask Configuration
# ===================
FLASK_ENV=development
# Set to 'production' for hosting
# FLASK_ENV=production
FLASK_DEBUG=1

# IMPORTANT: Generate a unique secret key for production!
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_32_byte_hex_string

# ===================
# Database
# ===================
# Development (SQLite):
DATABASE_URL=sqlite:///chaintrack_dev.db

# Production (PostgreSQL) - Use your hosting provider's URL:
# Railway: DATABASE_URL=postgresql://user:pass@host:port/db
# Render: DATABASE_URL=postgresql://user:pass@host:port/db
# Supabase: DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require
# DATABASE_URL=postgresql://user:password@localhost:5432/chaintrack

# ===================
# JWT Configuration
# ===================
# IMPORTANT: Generate a unique JWT secret for production!
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_32_byte_hex_string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ===================
# CORS Configuration
# ===================
# Add your frontend domain(s) separated by commas
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# For production, add your deployed frontend URL:
# CORS_ORIGINS=https://chaintrack.vercel.app,https://chaintrack.netlify.app

# ===================
# Ethereum Blockchain
# ===================
# Network: localhost, sepolia, mainnet
ETHEREUM_NETWORK=sepolia

# RPC URL - Get free keys from:
# - Infura: https://infura.io
# - Alchemy: https://alchemy.com
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# Or Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployed contract addresses (fill after deployment)
CONTRACT_ADDRESS=
SHIPMENT_REGISTRY_ADDRESS=

# Deployer wallet private key (for signing transactions)
# WARNING: Keep this secret! Never commit real private keys!
# For production, use a dedicated deployer wallet with minimal funds
DEPLOYER_PRIVATE_KEY=

# ===================
# QR Code Configuration
# ===================
QR_CODE_BASE_URL=http://localhost:5173/verify
# For production:
# QR_CODE_BASE_URL=https://your-domain.com/verify

# ===================
# Pinata/IPFS (Delivery Photos)
# ===================
# Get your keys at https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ===================
# Email Notifications (SendGrid)
# ===================
# Get your API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@chaintrack.io
NOTIFICATION_FROM_NAME=ChainTrack

# ===================
# SMS Notifications (Twilio)
# ===================
# Get your credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# ===================
# Frontend URL
# ===================
FRONTEND_URL=http://localhost:5173
# For production:
# FRONTEND_URL=https://your-domain.com
