# ChainTrack Backend - Production Environment Variables (Railway/Render)
# These should be set as environment variables in your hosting platform

# ==========================================
# REQUIRED VARIABLES
# ==========================================

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-min-32-chars-please-change-this
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-please-change-this

# Database (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Railway provides this automatically)
REDIS_URL=redis://default:password@host:6379

# Frontend URL (your Vercel deployment)
FRONTEND_URL=https://your-app.vercel.app

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ==========================================
# BLOCKCHAIN (Sepolia Testnet)
# ==========================================

# Infura or Alchemy
WEB3_PROVIDER_URI=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployer Wallet (for minting tokens, etc.)
BLOCKCHAIN_PRIVATE_KEY=your-private-key-without-0x-prefix

# Contract Addresses (Already Deployed)
PRODUCT_REGISTRY_ADDRESS=0x141878E69201172C2aeeC39C4882b61089f64177
SHIPMENT_REGISTRY_ADDRESS=0xd0Db8e81115297194659543c47BFda3b061B059b
TOKEN_ADDRESS=0x1eD9C16BaA65F32EEF00639b112B792be498b43a

# ==========================================
# EMAIL NOTIFICATIONS (Brevo - Free 300/day)
# ==========================================

BREVO_API_KEY=your-brevo-api-key
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_FROM_NAME=ChainTrack

# SendGrid (Optional Fallback)
# SENDGRID_API_KEY=your-sendgrid-api-key

# ==========================================
# IPFS STORAGE (Pinata - Free 100 files/day)
# ==========================================

PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key

# ==========================================
# SECURITY
# ==========================================

# Rate Limiting
RATELIMIT_STORAGE_URL=${REDIS_URL}
RATELIMIT_HEADERS_ENABLED=true

# JWT Token Expiry
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800
