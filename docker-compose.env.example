# ChainTrack Docker Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =====================================================
# DATABASE CONFIGURATION (REQUIRED)
# =====================================================
DB_USER=chaintrack
DB_PASSWORD=your_secure_password_here
DB_NAME=chaintrack

# =====================================================
# SECURITY KEYS (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# =====================================================
SECRET_KEY=your_64_char_hex_secret_key_here
JWT_SECRET_KEY=your_64_char_hex_jwt_secret_here

# =====================================================
# APPLICATION SETTINGS
# =====================================================
FLASK_ENV=production
CORS_ORIGINS=https://yourdomain.com

# =====================================================
# BLOCKCHAIN CONFIGURATION (Optional)
# =====================================================
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_project_id
CONTRACT_ADDRESS=0x_your_contract_address
DEPLOYER_PRIVATE_KEY=your_private_key_never_commit_this

# =====================================================
# RATE LIMITING (Optional - uses memory by default)
# =====================================================
REDIS_URL=redis://redis:6379/0

# =====================================================
# SMS & EMAIL SERVICES (Optional)
# =====================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=

# =====================================================
# IPFS/PINATA CONFIGURATION (Optional)
# =====================================================
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
