# ChainTrack Docker Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =====================================================
# DATABASE CONFIGURATION (REQUIRED)
# =====================================================
DB_USER=chaintrack
DB_PASSWORD=your_secure_password_here
DB_NAME=chaintrack

# =====================================================
# SECURITY KEYS (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# =====================================================
SECRET_KEY=your_64_char_hex_secret_key_here
JWT_SECRET_KEY=your_64_char_hex_jwt_secret_here

# =====================================================
# APPLICATION SETTINGS
# =====================================================
FLASK_ENV=production
CORS_ORIGINS=https://yourdomain.com

# =====================================================
# BLOCKCHAIN CONFIGURATION (Optional)
# =====================================================
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_project_id
CONTRACT_ADDRESS=0x_your_contract_address
DEPLOYER_PRIVATE_KEY=your_private_key_never_commit_this

# =====================================================
# RATE LIMITING (Optional - uses memory by default)
# =====================================================
REDIS_URL=redis://redis:6379/0

# =====================================================
# SMS & EMAIL SERVICES (Optional)
# =====================================================

# Email Provider - Brevo (Sendinblue) - FREE: 300 emails/day
# Sign up at: https://www.brevo.com/
BREVO_API_KEY=your_brevo_api_key_here

# Email Provider - SendGrid (fallback)
# Sign up at: https://sendgrid.com/
SENDGRID_API_KEY=

# From address for emails
NOTIFICATION_FROM_EMAIL=noreply@chaintrack.io
NOTIFICATION_FROM_NAME=ChainTrack

# WhatsApp via Twilio - FREE within 24h session window
# Sign up at: https://www.twilio.com/
# For testing: Use Twilio WhatsApp Sandbox
# Users must first message "join <your-sandbox-keyword>" to +1 415 523 8886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS (Optional - costs money per message)
# Only used if SMS_ENABLED=true
SMS_ENABLED=false
TWILIO_SMS_FROM=

# =====================================================
# IPFS/PINATA CONFIGURATION (Optional)
# =====================================================
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
