# ============================================
# ChainTrack Smart Contracts Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to git!
# ============================================

# ===================
# Network RPC URLs
# ===================
# Get free API keys from:
# - Infura: https://infura.io (create account -> create new key)
# - Alchemy: https://alchemy.com (create account -> create app)

# Sepolia Testnet (recommended for testing)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Or Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Mainnet (for production - use with caution!)
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# ===================
# Deployer Wallet
# ===================
# Private key for deploying contracts
# ⚠️  SECURITY WARNING:
#     - NEVER commit real private keys to git!
#     - Use a dedicated wallet for deployment with minimal funds
#     - Fund with just enough ETH for deployment + gas fees
#
# To get your private key from MetaMask:
# 1. Open MetaMask -> Account Details -> Export Private Key
# 2. Copy the key (without 0x prefix)
#
DEPLOYER_PRIVATE_KEY=

# ===================
# Contract Verification
# ===================
# Get your API key at https://etherscan.io/myapikey
# This allows automatic contract verification on Etherscan
ETHERSCAN_API_KEY=

# ===================
# Gas Configuration
# ===================
# Enable gas usage reports during tests
REPORT_GAS=true

# Gas price in gwei (optional, uses network default if not set)
# GAS_PRICE=20
