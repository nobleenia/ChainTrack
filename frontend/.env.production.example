# ChainTrack Frontend - Production Environment Variables
# Copy this to .env.production.local and fill in the values

# Backend API URL (your Railway/Render deployment)
VITE_API_URL=https://your-backend.railway.app/api

# Blockchain Configuration (Sepolia)
VITE_CHAIN_ID=11155111
VITE_NETWORK_NAME=sepolia

# Smart Contract Addresses (Already Deployed to Sepolia)
VITE_PRODUCT_REGISTRY_ADDRESS=0x141878E69201172C2aeeC39C4882b61089f64177
VITE_SHIPMENT_REGISTRY_ADDRESS=0xd0Db8e81115297194659543c47BFda3b061B059b
VITE_TOKEN_ADDRESS=0x1eD9C16BaA65F32EEF00639b112B792be498b43a

# Sepolia RPC URL (Infura or Alchemy)
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Block Explorer
VITE_BLOCK_EXPLORER=https://sepolia.etherscan.io

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXXXX
