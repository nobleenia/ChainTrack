# ChainTrack Environment Variables
# Copy this file to .env and configure for your environment

# =====================
# General Configuration
# =====================
NODE_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1

# =====================
# Security Keys
# =====================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-minimum-32-chars

# =====================
# Database Configuration
# =====================
DB_USER=chaintrack
DB_PASSWORD=chaintrack123
DB_NAME=chaintrack
DATABASE_URL=postgresql://chaintrack:chaintrack123@localhost:5432/chaintrack

# For local SQLite development (simpler setup):
# DATABASE_URL=sqlite:///chaintrack_dev.db

# =====================
# Frontend Configuration
# =====================
VITE_API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =====================
# Blockchain Configuration
# =====================
# Ethereum Network: sepolia (testnet) or mainnet
ETHEREUM_NETWORK=sepolia

# Get from https://infura.io or https://alchemy.com
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployed contract address (after running npm run deploy:sepolia in /contracts)
CONTRACT_ADDRESS=

# Private key for deploying contracts and signing transactions
# ⚠️ NEVER commit this! Use a dedicated wallet for development
DEPLOYER_PRIVATE_KEY=

# For contract verification on Etherscan
ETHERSCAN_API_KEY=

# =====================
# QR Code Configuration
# =====================
QR_CODE_BASE_URL=http://localhost:5173/verify

# =====================
# Optional: Redis (for caching in production)
# =====================
REDIS_URL=redis://localhost:6379/0
