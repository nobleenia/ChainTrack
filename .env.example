# ChainTrack Environment Variables
# =================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Quick Start:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d

# =====================================================
# DATABASE CONFIGURATION (REQUIRED)
# =====================================================
DB_USER=chaintrack
DB_PASSWORD=change_this_secure_password
DB_NAME=chaintrack

# =====================================================
# SECURITY KEYS (REQUIRED)
# =====================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_64_char_hex_secret
JWT_SECRET_KEY=change_this_to_another_64_char_hex_secret

# =====================================================
# APPLICATION SETTINGS
# =====================================================
FLASK_ENV=production
# For development use: http://localhost:5173
# For production use: https://your-frontend-domain.vercel.app
CORS_ORIGINS=http://localhost:5173

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================
VITE_API_URL=http://localhost:5000/api

# =====================================================
# BLOCKCHAIN CONFIGURATION
# =====================================================
# Get free RPC URL from https://infura.io or https://alchemy.com
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_project_id

# Deployed contract addresses (Sepolia testnet)
PRODUCT_REGISTRY_ADDRESS=0xB3f85efF20DCA5cae0a67c4092E5092309C7e69d
SHIPMENT_REGISTRY_ADDRESS=0x7dBC3BCb4173F8EB1cb813Fb2B9F6b90F7E5baBe
CHAINTRACK_TOKEN_ADDRESS=0x1eD9C16BaA65F32EEF00639b112B792be498b43a

# NEVER commit private keys!
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# =====================================================
# EMAIL NOTIFICATIONS (Required for 2FA & alerts)
# =====================================================
# Brevo (Sendinblue) - FREE: 300 emails/day
# Sign up: https://www.brevo.com/
BREVO_API_KEY=your_brevo_api_key

# SendGrid (fallback) - FREE: 100 emails/day  
# Sign up: https://sendgrid.com/
SENDGRID_API_KEY=

NOTIFICATION_FROM_EMAIL=noreply@chaintrack.io
NOTIFICATION_FROM_NAME=ChainTrack

# =====================================================
# WHATSAPP NOTIFICATIONS (Optional)
# =====================================================
# Twilio - FREE within 24h session window
# Sign up: https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =====================================================
# IPFS/PINATA (Optional - for document storage)
# =====================================================
# Sign up: https://pinata.cloud/
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# =====================================================
# REDIS (for caching & rate limiting)
# =====================================================
REDIS_URL=redis://redis:6379/0

# =====================================================
# QR CODE CONFIGURATION
# =====================================================
QR_CODE_BASE_URL=http://localhost:5173/verify
